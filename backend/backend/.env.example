# ── Azure Key Vault ────────────────────────────────────────────────────────────
# All secrets are pulled from Key Vault at runtime via DefaultAzureCredential.
# Locally, set these directly. In production, only KEY_VAULT_URL is needed.
KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# ── Database (only used locally without Key Vault) ─────────────────────────────
DB_SERVER=your-server.database.windows.net
DB_NAME=machine_monitoring
DB_USER=app_user
DB_PASSWORD=change_me

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Azure AD / JWT Auth ────────────────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id          # App registration client ID
AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# ── Application Insights ───────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ── App Settings ───────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","https://your-static-webapp.azurestaticapps.net"]
API_V1_PREFIX=/api/v1

# ── WebSocket ──────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30                 # seconds
WS_MAX_CONNECTIONS_PER_MACHINE=50

# ── Cache TTLs (seconds) ───────────────────────────────────────────────────────
CACHE_TTL_MACHINES=300
CACHE_TTL_SIGNALS=300
CACHE_TTL_READINGS=10
