# ── Azure Key Vault ────────────────────────────────────────────────────────────
# All secrets are pulled from Key Vault at runtime via DefaultAzureCredential.
# Locally, set these directly. In production, only KEY_VAULT_URL is needed.
KEY_VAULT_URL=https://demodatahub-key.vault.azure.net/

# ── Database (only used locally without Key Vault) ─────────────────────────────
DB_SERVER=factory-raw-data-db.database.windows.net
DB_NAME=FactoryDashDB
DB_USER=factoryadmin
DB_PASSWORD=Honhon@07

# ── Redis ──────────────────────────────────────────────────────────────────────
#REDIS_URL=redis://localhost:6379/0

# ── Azure AD / JWT Auth ────────────────────────────────────────────────────────
AZURE_TENANT_ID=e57ff942-6d15-4812-80f2-13c68cbe52b2
AZURE_CLIENT_ID=ef330792-e980-49d5-8bb7-d4e7d0bc6554         # App registration client ID
AZURE_AUTHORITY=https://login.microsoftonline.com/e57ff942-6d15-4812-80f2-13c68cbe52b2

# ── Application Insights ───────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=f3ac82a7-3c78-498c-a6e2-627ac9e30ab0;IngestionEndpoint=https://centralus-2.in.applicationinsights.azure.com/;LiveEndpoint=https://centralus.livediagnostics.monitor.azure.com/;ApplicationId=ed6f24ec-259b-4e80-b147-b97989f8b64a

# ── App Settings ───────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","https://your-static-webapp.azurestaticapps.net"]
API_V1_PREFIX=/api/v1

# ── WebSocket ──────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30                 # seconds
WS_MAX_CONNECTIONS_PER_MACHINE=50

# ── Cache TTLs (seconds) ───────────────────────────────────────────────────────
CACHE_TTL_MACHINES=300
CACHE_TTL_SIGNALS=300
CACHE_TTL_READINGS=10
